{
  "capture_enabled": {
    "description": "采集并整理群聊记忆",
    "type": "bool",
    "default": false,
    "obvious_hint": true,
    "hint": "总开关。只处理下方白名单群，数据写入插件自己的按群 SQLite。"
  },
  "allowed_umos": {
    "description": "测试群 UMO 白名单",
    "type": "list",
    "default": [],
    "obvious_hint": true,
    "hint": "例如 aiocqhttp:GroupMessage:123456；留空表示所有群，试运行建议只填一个群。"
  },
  "subconscious_enabled": {
    "description": "启用独立潜意识",
    "type": "bool",
    "default": true,
    "obvious_hint": true,
    "hint": "使用插件专属 LLM 重建记忆，与当前聊天主模型分离。"
  },
  "subconscious_provider_id": {
    "description": "潜意识模型",
    "type": "string",
    "default": "deepseek/deepseek-v4-flash",
    "_special": "select_provider",
    "obvious_hint": true,
    "condition": {"subconscious_enabled": true},
    "hint": "选择 AstrBot 已配置的低成本聊天模型 Provider。"
  },
  "feedback_learning_enabled": {
    "description": "从后续反馈修正记忆",
    "type": "bool",
    "default": false,
    "obvious_hint": true,
    "condition": {"capture_enabled": true},
    "hint": "把可归因的人类反馈写回可塑图，并保留未决或竞争释义。"
  },
  "embedding_enabled": {
    "description": "启用本地 Embedding 候选",
    "type": "bool",
    "default": true,
    "condition": {"subconscious_enabled": true},
    "hint": "仅在本机/服务器运行，不调用 AstrBot Embedding Provider 或远程 Embedding API。"
  },
  "private_daily_token_budget": {
    "description": "每群每日潜意识 Token 上限",
    "type": "int",
    "default": 120000,
    "condition": {"subconscious_enabled": true},
    "hint": "覆盖整理、反馈维护和重建；达到上限后静默跳过，0 表示不限。"
  },
  "feedback_window_seconds": {"type": "int", "default": 21600, "invisible": true},
  "feedback_trace_ttl_seconds": {"type": "int", "default": 86400, "invisible": true},
  "feedback_hypothesis_ttl_days": {"type": "int", "default": 180, "invisible": true},
  "feedback_max_pending_per_wake": {"type": "int", "default": 2, "invisible": true},
  "feedback_max_active_hypotheses": {"type": "int", "default": 200, "invisible": true},
  "feedback_maintenance_steps": {"type": "int", "default": 6, "invisible": true},
  "feedback_min_commit_score": {"type": "float", "default": 0.65, "invisible": true},
  "embedding_backend": {"type": "string", "default": "fastembed", "invisible": true},
  "embedding_model_name": {"type": "string", "default": "BAAI/bge-small-zh-v1.5", "invisible": true},
  "embedding_cpu_threads": {"type": "int", "default": 1, "invisible": true},
  "embedding_batch_size": {"type": "int", "default": 16, "invisible": true},
  "embedding_query_prompt_name": {"type": "string", "default": "", "invisible": true},
  "embedding_max_seq_length": {"type": "int", "default": 512, "invisible": true},
  "embedding_preload_on_startup": {"type": "bool", "default": false, "invisible": true},
  "embedding_top_k": {"type": "int", "default": 12, "invisible": true},
  "distillation_max_messages": {"type": "int", "default": 80, "invisible": true},
  "distillation_overlap_messages": {"type": "int", "default": 12, "invisible": true},
  "auto_distillation_enabled": {"type": "bool", "default": true, "invisible": true},
  "auto_distillation_min_pending": {"type": "int", "default": 30, "invisible": true},
  "maintenance_interval_seconds": {"type": "int", "default": 300, "invisible": true},
  "wake_on_llm_request": {"type": "bool", "default": true, "invisible": true},
  "candidate_seed_floor": {"type": "float", "default": -1.0, "invisible": true},
  "host_gate_min_score": {"type": "float", "default": -1.0, "invisible": true},
  "runtime_host_evidence_gate": {"type": "bool", "default": false, "invisible": true},
  "consult_tool_enabled": {"type": "bool", "default": true, "invisible": true},
  "expose_traversal_tools": {"type": "bool", "default": false, "invisible": true},
  "max_loop_steps": {"type": "int", "default": 6, "invisible": true},
  "subconscious_timeout_seconds": {"type": "int", "default": 45, "invisible": true},
  "max_query_chars": {"type": "int", "default": 4000, "invisible": true},
  "max_brief_chars": {"type": "int", "default": 3000, "invisible": true},
  "max_search_results": {"type": "int", "default": 20, "invisible": true},
  "log_message_content": {"type": "bool", "default": false, "invisible": true}
}
